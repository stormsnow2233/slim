  {
    "id": "lnovel",
    "name": "轻小说百科",
    "base": "https://lnovel.tw",
    "mirrors": [
      "https://lnovel.org"
    ],
    "enabled": true,
    "search": {
      "url": "/books?q%5Bname_cont%5D={key}",
      "method": "GET",
      "body": "",
      "list": "a[href*='/books-'], div.book-item, .card",
      "fields": {
        "title": "@text || h5@text || h4@text || .title@text",
        "url": "@href",
        "cover": "img@src"
      }
    },
    "detail": {
      "title": "h1@text || meta[property='og:title']@content || title@text",
      "author": "a[href*='authors_id_eq']@text || a[href*='author']@text || dt:contains(作者) + dd@text || meta[name='author']@content",
      "intro": "div.card-body p.my-2@text || meta[name='description']@content || .card-text@text",
      "cover": "img[src*='webpic']@src || .card img[src*='/uploads/']@src || meta[property='og:image']@content || img@src"
    },
    "toc": {
      "list": "a[href*='/chapters-']",
      "name": "@text",
      "url": "@href"
    },
    "content": {
      "body": "article@html || .reading-content@html || #content@html"
    }
  }
