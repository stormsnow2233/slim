  {
    "id": "wenku8",
    "name": "轻小说文库",
    "base": "https://www.wenku8.net",
    "mirrors": [
      "https://www.wenku8.cc"
    ],
    "enabled": true,
    "search": {
      "url": "/modules/article/search.php?searchkey={key}&searchtype=articlename",
      "method": "GET",
      "body": "searchtype=articlename&searchkey={key}&charset=gbk",
      "list": "div[style*='width:373px'], div[style*='width: 373px'], #content table td > div, table td > div[style*='width'], table.grid tr, .grid tr",
      "fields": {
        "title": "div:nth-of-type(2) b a@title || div:nth-of-type(2) a@title || b a@title || b a@text || td:nth-child(1) a@text || td:nth-child(2) a@text",
        "url": "div:nth-of-type(2) b a@href || div:nth-of-type(2) a@href || b a@href || div a[href*=/book/]@href || td:nth-child(1) a@href || td:nth-child(2) a@href",
        "author": "div:nth-of-type(2) p:contains(作)@text || p:contains(作)@text || td:nth-child(3)@text",
        "intro": "div:nth-of-type(2) p:contains(简)@text || div:nth-of-type(2) p:contains(介)@text || p:contains(简)@text",
        "cover": "div:nth-of-type(1) img@src || img@src"
      }
    },
    "detail": {
      "title": "h1@text || #title@text || title@text",
      "author": "#info a@text || .author@text || td:contains(小说作者)@text",
      "intro": "#intro@text || .intro@text || td:contains(内容简介)@text",
      "cover": "img[src*=image]@src || #fmimg img@src || .cover img@src"
    },
    "toc": {
      "list": "table.css td.ccss a, table.css td a, td.ccss a, .chapter_list a",
      "name": "@text",
      "url": "@href"
    },
    "content": {
      "body": "div#content@html || #content@html || #acontent@html"
    }
  },
